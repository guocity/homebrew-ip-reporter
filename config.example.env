# ip-reporter configuration
# Copy this to one of the locations the reporter searches (install.sh handles
# this for you, placing it at ~/.config/ip-reporter/config.env), then fill in
# the token. Environment variables of the same name override these values.

# REQUIRED. The Bearer token for this machine. Generate it on the server host,
# bound to this machine's hostname, e.g.:
#     cd server && node manage-tokens.js generate "$(hostname)" telemetry
TELEMETRY_TOKEN=

# OPTIONAL. Override the ingestion endpoint (defaults to the value below).
# The Cloudflare Worker here validates the token and bridges the payload to the
# MQTT broker (mqtt.lgnat.com), so a single HTTP POST reaches both.
TELEMETRY_URL=https://telemetry.lgnat.com/api/telemetry

# OPTIONAL. Adds an explicit service_id field to the JSON body. Normally you can
# leave this blank — the gateway derives the service_id from the token itself.
SERVICE_ID=
